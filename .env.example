# Spotify Developer app credentials — copy to .env and fill in real values.
# Register an app at https://developer.spotify.com/dashboard
# Add the redirect URI below to the app settings EXACTLY (loopback IP, not "localhost").
SPOTIPY_CLIENT_ID=your_client_id_here
SPOTIPY_CLIENT_SECRET=your_client_secret_here
SPOTIPY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Phase 5 external discovery signal — Last.fm. Get a free key at
# https://www.last.fm/api/account/create . Only the API key is used (unauthenticated
# read methods: getSimilar / getTopTags). The shared secret is for signed write
# methods (scrobbling) we don't use; include it only if you have it.
LASTFM_API_KEY=your_lastfm_api_key_here
# LASTFM_SECRET=your_lastfm_shared_secret_here

# Phase 6 (Mode C) — remote MCP server for mobile Claude. Only needed on the host (Pi).
# MCP_BEARER_TOKEN: a long random secret the connector sends; the server refuses to start
# without it. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# MCP_PUBLIC_URL: the public HTTPS URL Cloudflare Tunnel exposes (used in auth metadata).
# MCP_BEARER_TOKEN=your_long_random_token_here
# MCP_PUBLIC_URL=https://spotify-mcp.example.com
# MCP_HOST=0.0.0.0
# MCP_PORT=8890

# Mode B only (standalone Anthropic API orchestrator) — not needed for Mode A.
# ANTHROPIC_API_KEY=your_anthropic_key_here
